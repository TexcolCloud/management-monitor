# Copy to .env for local PostgreSQL and Feishu settings. Never commit real secrets.

# PostgreSQL (compatible names)
PG_ENABLED=true
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
PGSCHEMA=public
PGTABLE=work_orders
PGCONNECT_TIMEOUT=10
# Optional non-negative milliseconds; empty keeps the PostgreSQL server defaults.
PGSTATEMENT_TIMEOUT_MS=
PGLOCK_TIMEOUT_MS=

# Feishu application and outbound recipient
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID_TYPE=chat_id
FEISHU_RECEIVE_ID=
# Legacy fallback used only when FEISHU_RECEIVE_ID is empty.
FEISHU_CHAT_ID=
FEISHU_APP_TIMEOUT_SECONDS=10
FEISHU_APP_MAX_ATTEMPTS=3
FEISHU_APP_RETRY_BACKOFF_SECONDS=0.5
FEISHU_APP_RETRY_MAX_BACKOFF_SECONDS=4

# Feishu SDK long-connection Excel export
FEISHU_EXPORT_ENABLED=false
# Comma-separated open_id allowlist. Leave empty while export is disabled.
FEISHU_EXPORT_ALLOWED_OPEN_IDS=
FEISHU_EXPORT_COMMAND=export

# Optional runtime config file. Relative paths are resolved from the project root.
WORKORDER_CONFIG=config/runtime.json

# Optional portal/API overrides. Empty values keep config/runtime.json defaults.
WORKORDER_LIST_API_URL=
WORKORDER_DETAIL_API_URL=
WORKORDER_ATTACHMENT_URL=
WORKORDER_PORTAL_URL=

# Optional login and network overrides
WORKORDER_LOGIN_WAIT_MS=
WORKORDER_POST_LOGIN_SETTLE_MS=
WORKORDER_REPLAY_CLICK_DELAY_MS=
WORKORDER_REPLAY_STEP_TIMEOUT_MS=
WORKORDER_REQUEST_TIMEOUT=
WORKORDER_REQUEST_RETRIES=
WORKORDER_RETRYABLE_API_CODES=
WORKORDER_DETAIL_MAX_FAILURES=
WORKORDER_RETRY_BACKOFF=
WORKORDER_ATTACHMENT_TIMEOUT_MS=
WORKORDER_ATTACHMENT_RETRIES=
WORKORDER_ATTACHMENT_CONCURRENCY=
WORKORDER_ATTACHMENT_MAX_FAILURES=

# Optional pagination overrides
WORKORDER_PAGE_SIZE=
WORKORDER_MAX_PAGES=
WORKORDER_STOP_ON_EMPTY_PAGE=
WORKORDER_VALIDATE_TOTAL=

# Optional output and compatibility paths
WORKORDER_CAPTURE_ROOT=
WORKORDER_EXPORT_ROOT=
WORKORDER_HEADERS_FILE=
WORKORDER_TOKEN_SOURCE_DIR=
WORKORDER_ATTACHMENT_DIR_NAME=
WORKORDER_LOGIN_PROFILE_DIR=
WORKORDER_LOGIN_NAVIGATION_FILE=

# Internal bridge authentication for adapter debugging. The main workflow generates
# an ephemeral value; leave this empty and never persist a real bridge token.
WORKORDER_BROWSER_BRIDGE_TOKEN=

# Optional Node executable lookup. Prefer NODE_EXE; NODE_PATH is a legacy fallback.
NODE_EXE=
NODE_PATH=

# Legacy emergency/debug compatibility only. Set in the current process when needed;
# never store a real portal token in this file.
WORKORDER_TOKEN=

# Optional diagnostic correlation id; normally generated automatically.
WORKORDER_RUN_ID=
